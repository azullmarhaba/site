# ------------------------------------------------------------
# AZUL — MARHABA MOROCCO 2027 · environment template
# Copy to .env and adjust. NEVER commit .env.
# ------------------------------------------------------------

# Database — XAMPP MySQL/MariaDB (phpMyAdmin manages this server)
DATABASE_URL="mysql://root:@localhost:3306/azul_morocco"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth.js (generate: npx auth secret / openssl rand -base64 32)
AUTH_SECRET="replace-with-32-byte-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth (leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (SMTP). Empty transport logs emails to the console in development.
EMAIL_SERVER=""
EMAIL_FROM="AZUL <hello@azulagency.ma>"

# Payments — "DEVELOPMENT" (simulated, dev only) or a future live provider
PAYMENT_PROVIDER="DEVELOPMENT"

# Media uploads
UPLOAD_PROVIDER="local"

# WhatsApp floating contact (international format, digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER="212600000000"

# Analytics (optional — GA4 / Plausible key; disabled when empty)
NEXT_PUBLIC_ANALYTICS_ID=""
